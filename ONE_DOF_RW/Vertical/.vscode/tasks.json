{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Build sensors",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
      "args": ["run", "-e", "sensors"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "PlatformIO: Upload sensors",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
      "args": ["run", "-e", "sensors", "-t", "upload"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "PlatformIO: Serial monitor",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
      "args": ["device", "monitor", "-b", "115200"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: List serial ports",
      "type": "process",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/platformio.exe",
      "args": ["device", "list"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "Test: Sensor math (host)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/test.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": ["$gcc"]
    }
  ]
}
